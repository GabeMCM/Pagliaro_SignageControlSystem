# ==============================================================================
# SIGNAGE CONTROL SYSTEM - VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env e preencha com as suas configurações.
# NUNCA envie seu arquivo .env com senhas reais para o Git (já está no .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR & REDE
# ------------------------------------------------------------------------------
# Porta local onde o backend roda (no Render o próprio Render injeta automaticamente)
PORT=8001

# Ambiente de execução: development ou production
NODE_ENV=development

# Origem permitida para CORS (* permite qualquer origem)
CORS_ORIGIN=*

# URL pública onde o sistema está hospedado (ex: https://meu-signage.onrender.com)
# No Render, a variável RENDER_EXTERNAL_URL é detectada automaticamente!
PUBLIC_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS MONGODB ATLAS (CUSTO R$ 0,00 VITALÍCIO)
# ------------------------------------------------------------------------------
# Para hospedar no Render e NÃO perder as salas e playlists ao reiniciar:
# 1. Crie uma conta gratuita em https://www.mongodb.com/cloud/atlas
# 2. Crie um Cluster M0 Free (Gratuito, escolha AWS São Paulo ou US)
# 3. Em "Database Access", crie um usuário e senha (ex: signage_user e senha forte)
# 4. Em "Network Access", adicione o IP 0.0.0.0/0 (permitir acesso de qualquer IP para o Render)
# 5. Em "Connect" -> "Drivers", copie a Connection String e substitua abaixo:
MONGODB_URI=mongodb+srv://<USUARIO>:<SENHA>@cluster0.abcde.mongodb.net/signage_control?retryWrites=true&w=majority

# Nome do banco de dados no MongoDB (opcional, padrão: signage_control)
MONGODB_DB_NAME=signage_control

# ------------------------------------------------------------------------------
# 3. SEGURANÇA & AUTENTICAÇÃO
# ------------------------------------------------------------------------------
# Chave mestra criptográfica para assinatura de tokens de sessão (HMAC) e pepper de senhas.
# O Render gera essa chave aleatória automaticamente via generateValue: true se não definida.
AUTH_SECRET=chave_secreta_super_segura_de_producao_pagliaro_signage_2026

# NOTA: Se MONGODB_URI não for configurada, o sistema usa automaticamente
# o armazenamento em arquivos JSON locais na pasta ./config/ (ótimo para testar offline).

# ------------------------------------------------------------------------------
# 4. INTEGRAÇÃO DROPBOX (MÚSICAS NA NUVEM & RENOVAÇÃO AUTOMÁTICA)
# ------------------------------------------------------------------------------
# Chave do aplicativo no Dropbox Developer Console (https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=1occi7mbnags2z2

# Chave secreta do aplicativo no Dropbox Console (Settings -> App secret)
DROPBOX_APP_SECRET=seu_app_secret_aqui

# Refresh Token perpétuo (renova o acesso automaticamente para sempre)
# Para gerar: rode `deno task dropbox:token`
DROPBOX_REFRESH_TOKEN=seu_refresh_token_aqui

# Pasta onde ficam suas músicas no Dropbox (ex: /Músicas ou /Signage/Musicas)
DROPBOX_MUSIC_FOLDER=/Músicas

# (Opcional) Access Token estático de teste de curta duração (sl.u...)
# DROPBOX_ACCESS_TOKEN=sl.u....

